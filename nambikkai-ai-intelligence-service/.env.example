# ── Application ────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010

# ── AI Provider ─────────────────────────────────────────────────────────────
# Options: lmstudio | bedrock
AI_PROVIDER=lmstudio

# ── LM Studio (local development) ──────────────────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-3-4b-it
LMSTUDIO_TIMEOUT_SECONDS=180
LMSTUDIO_MAX_TOKENS=300
LMSTUDIO_TEMPERATURE=0.3

# ── AWS Bedrock (production) ──────────────────────────────────────────────
# Credentials: use environment variables, ~/.aws/credentials, or IAM role.
# Required IAM permission: bedrock:InvokeModel on the configured model ARN.
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.3

# ── Deterministic Gating Thresholds ────────────────────────────────────────
# Velocity ratio: current_hour_delta_views / seven_day_rolling_hourly_baseline
VELOCITY_NOMINAL_THRESHOLD=1.5
VELOCITY_SURGE_THRESHOLD=3.0
# Like acceleration: (delta_likes / delta_views) * 100
LIKE_ACCELERATION_THRESHOLD=5.0
