# ── Application ────────────────────────────────────────────────────────────
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8010

# ── AI Provider ─────────────────────────────────────────────────────────────
# Options: bedrock (production) | lmstudio (local development)
AI_PROVIDER=bedrock

# ── AWS Bedrock (production) ──────────────────────────────────────────────
# Credentials: use environment variables, ~/.aws/credentials, or IAM role.
# Required IAM permission: bedrock:InvokeModel on the configured model ID.
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_SESSION_TOKEN=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_TIMEOUT_SECONDS=60
BEDROCK_MAX_TOKENS=1024
BEDROCK_TEMPERATURE=0.3

# ── LM Studio (local development only) ──────────────────────────────────────
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=gemma-3-4b-it
LMSTUDIO_TIMEOUT_SECONDS=180
LMSTUDIO_MAX_TOKENS=800
LMSTUDIO_TEMPERATURE=0.3

# ── PostgreSQL (shared DB — AI-specific tables only) ────────────────────────
# Format: postgresql://user:password@host:port/dbname
# Points to the same database as the dashboard backend.
# The AI service only reads/writes its own *_ai tables.
# For the import script: set DATABASE_URL to the same connection string.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# ── Dashboard historical-data API ───────────────────────────────────────────
# The AI service calls this endpoint to fetch content history for training/analysis.
# Production example: https://your-dashboard-domain.com/api/ai-agent/historical-data
# Local development: http://localhost:4000/api/ai-agent/historical-data
NAMBIKKAI_API_URL=https://<YOUR_DASHBOARD_DOMAIN>/api/ai-agent/historical-data
AI_AGENT_API_KEY=<AI_AGENT_API_KEY>
NAMBIKKAI_API_TIMEOUT_SECONDS=120
NAMBIKKAI_API_PAGE_SIZE=500

# ── Deterministic Gating Thresholds (R&D spec) ─────────────────────────────
# Vr < 1.5              -> NOMINAL
# 1.5 <= Vr < 2.5       -> ELEVATED
# Vr >= 2.5 OR La >= 8% -> BOOMING_SURGE
VELOCITY_NOMINAL_THRESHOLD=1.5
VELOCITY_SURGE_THRESHOLD=2.5
LIKE_ACCELERATION_THRESHOLD=8.0

# ── Bulk Scan Configuration ─────────────────────────────────────────────────
# LLM_BATCH_SIZE: max new LLM calls per platform per scan cycle.
# Set to a high value (e.g. 1000) to ensure all eligible items are processed
# in one scan — eligible items must never be left as 'pending' after a completed scan.
LLM_BATCH_SIZE=1000
# LLM_CONCURRENCY: number of concurrent LLM requests per scan cycle.
# Default 3 is safe for LM Studio (local CPU inference).
# Production Bedrock can handle higher values (e.g. 5-10) depending on throttling limits.
LLM_CONCURRENCY=3
# AI_SCAN_INTERVAL_SECONDS: seconds between scheduled background scans (default 1 hour)
AI_SCAN_INTERVAL_SECONDS=3600

# ── XGBoost Model Artifact ──────────────────────────────────────────────────
# Path to the directory containing xgboost_model.json and metadata.json.
# Leave blank to disable XGBoost loading (safe default — deterministic classification remains active).
# Set to "models/track_a_xgboost" (relative to service root) or an absolute path.
# Run: python scripts/train_xgboost.py   to train and save the artifact.
# The model is loaded ONCE at startup — never retrained during API requests.
XGBOOST_MODEL_PATH=models/track_a_xgboost
# Quality gate thresholds — calibrated for real class imbalance (~0.9% positive rate).
# Primary gate: ROC-AUC must clearly beat random (0.50) — default 0.70.
XGBOOST_MIN_TEST_ROC_AUC=0.70
# Secondary gate: model must recall at least 30% of real surge events.
XGBOOST_MIN_TEST_RECALL=0.30
# F1 gate is set low because F1 is inherently constrained at <1% positive rate.
XGBOOST_MIN_TEST_F1=0.03

# ── CORS Configuration ───────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the AI service CORS middleware.
# Development: http://localhost:3000,http://localhost:4000
# Production: set to your dashboard's actual origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# ── Email Reporting (environment-configured only) ───────────────────────────
# EMAIL_ENABLED: false in development (default), true only in production when configured
# Reports EMAIL_CONFIGURATION_PENDING until valid SMTP credentials and OWNER_EMAIL are set.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
OWNER_EMAIL=

